# Docker Compose 用的环境变量（阶段 11）
#
# 用法：cp .env.example .env 后填好下面三个值，再 docker compose up -d --build
#
# 与 backend/.env 的分工，别混用：
#   backend/.env      本地开发用（backend/scripts/*.sh 启动四个组件时读它）
#   .env（本文件）    容器编排用（docker compose 读它做变量插值）
# 服务内部连接串由 docker-compose.yml 直接写死成容器网络里的服务名
# （postgres / redis / ai-service），不需要在这里重复配置。

# 必填：PostgreSQL 密码与 Flask/JWT 密钥
POSTGRES_PASSWORD=change-me-please
SECRET_KEY=change-me-too-and-make-it-long

# 可选
POSTGRES_DB=ortho
JWT_SECRET_KEY=
BACKEND_PORT=5000
FRONTEND_PORT=8080
AI_PORT=8000
# 容器内默认用 CPU 跑嵌入/重排（无需 nvidia-container-toolkit）；
# 宿主有可用 GPU 且已装 toolkit 时可改成 cuda
RAG_DEVICE=cpu
# 只要 CPU 版 torch 时设成 https://download.pytorch.org/whl/cpu，镜像能小一大半
TORCH_INDEX_URL=
