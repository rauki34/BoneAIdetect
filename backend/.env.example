# 复制本文件为 .env 并按需修改
# .env 不会被提交到 git（见 .gitignore）

# ---------- 运行环境 ----------
# development | production
FLASK_ENV=development

# 日志级别：DEBUG | INFO（默认） | WARNING | ERROR
# 注意：DEBUG 会输出验证码明文，仅用于本地调试
LOG_LEVEL=INFO

# ---------- 安全（生产环境必须修改）----------
SECRET_KEY=dev-secret-key-change-in-production
JWT_SECRET_KEY=dev-jwt-secret-change-in-production

# ---------- 数据库 ----------
# 留空 / 注释掉 = 使用 SQLite：backend/instance/bone_detection.db
#
# PostgreSQL（含 pgvector）：本地用 conda 安装，启停见 scripts/pg.sh
#   conda create -n ortho-pg -c conda-forge postgresql pgvector
#   bash scripts/pg.sh start
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/ortho

# ---------- 跨域 ----------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- 外部服务 ----------
REDIS_URL=redis://127.0.0.1:6379/0
AI_SERVICE_URL=http://127.0.0.1:8000

# ---------- 限流 ----------
# 分层限流：认证层按 IP，AI 层按用户，通用层按用户或 IP
RATE_LIMIT_LOGIN=5         # 登录：次/分钟/IP（防爆破）
RATE_LIMIT_REGISTER=3      # 注册：次/5分钟/IP（防批量注册）
RATE_LIMIT_CAPTCHA=20      # 验证码：次/分钟/IP
RATE_LIMIT_AI=10           # AI 调用：次/分钟/用户
RATE_LIMIT_GENERAL=100     # 通用：次/分钟

# 是否信任反向代理的 X-Forwarded-For。
# 直连部署必须保持 false —— 该头可被伪造，信任它会让攻击者
# 通过伪造 IP 绕过限流。
TRUST_PROXY=false

# 不限流的角色（急诊场景下不应因限流阻断医护使用）
RATE_LIMIT_BYPASS_ROLES=admin

# ---------- RAG 知识库 ----------
# 总开关。显存吃紧、或演示时需要把 GPU 让给 YOLO 时置 false：
# 对话会退回"无参考资料"的普通回答，其余功能不受影响
RAG_ENABLED=true

# 模型。首次使用会自动下载（bge-m3 约 2.2GB，重排约 2.3GB）
RAG_EMBED_MODEL=BAAI/bge-m3
RAG_RERANK_MODEL=BAAI/bge-reranker-v2-m3
# auto | cuda | cpu。cpu 可让出显存，但检索延迟升到数秒
RAG_DEVICE=auto
RAG_FP16=true

# 批大小。6GB 显存与 YOLO 共存时保持 8；
# 用 scripts/ingest_knowledge.py --batch 32 可在 YOLO 不占显存时加速入库
RAG_EMBED_BATCH=8
RAG_RERANK_BATCH=8

# 检索参数
RAG_TOP_K=5              # 最终返回给模型的资料条数
RAG_RECALL_K=20          # 每路召回的候选数
RAG_RRF_K=60             # RRF 融合常数
RAG_PERSONAL_SLOTS=2     # 患者本人病历的保障槽位数
RAG_MIN_SCORE=0.0        # 个人切片进入保障槽位的最低重排分

# 启动时预热模型。默认 false 以免拖慢启动；开启后首次检索不必等模型加载
RAG_WARMUP=false
RAG_CACHE_TTL=600        # 检索结果缓存秒数
RAG_MAX_UPLOAD_MB=50     # 单文件上传上限（限制的是请求体大小，与入库方式无关）

# 知识库限流
RATE_LIMIT_KB_UPLOAD=10  # 上传：次/5分钟/用户
RATE_LIMIT_KB_SEARCH=60  # 检索预览：次/分钟/用户

# ---------- 用户额度（阶段 9）----------
# 分钟级限流只能约束"多快"，约束不了"总量"：一次 Agent 请求最坏触发 5 次 LLM
# 调用，按 5 次/分钟放行等于一小时能烧 25 次推演。所以另加两个时间尺度。
# 计数存 Redis（跨进程、重启不清零）；Redis 不可用时退回进程内计数并**放行**。
QUOTA_ENABLED=true
QUOTA_SESSION_MAX=30        # 单个会话的对话轮数上限（新建会话即重置）
QUOTA_DAILY_PER_USER=100    # 单用户每日对话次数上限（按**本地日期**重置，非 UTC）
QUOTA_SESSION_TTL=604800    # 会话计数保留 7 天
QUOTA_BYPASS_ROLES=admin    # 豁免额度的角色；压测套件复跑时可临时用 admin 账号，
                            # 否则同一账号连跑几十轮会撞上每日额度（看起来像功能坏了）

# Agent 对话限流（分钟级）：一次请求最坏 5 次 LLM 调用，故取 AI 对话阈值的一半
RATE_LIMIT_AGENT_CHAT=5

# ---------- Agent 康复助手（阶段 9）----------
# 患者端的「深度分析」：模型自主决定调用哪些工具（指南检索 / 本人病历 /
# 检测报告 / 档案 / 复诊时间），多轮编排后作答，并返回执行轨迹。
AGENT_ENABLED=true              # 总开关；置 false 时该端点退回普通对话（响应 degraded=true）
AGENT_MAX_ITERATIONS=5          # LLM 轮次上限；每轮都要重发完整上下文，直接影响成本
AGENT_MAX_TOOL_CALLS=8          # 工具调用总数上限（实测模型会一轮并行发多个 tool_calls）
AGENT_TIMEOUT_SECONDS=150       # 整条编排的墙钟预算；首次请求可能等 1-2 分钟
AGENT_LLM_TIMEOUT=60            # 单次 LLM 调用上限；实际取 min(它, 剩余预算)
AGENT_MAX_TOKENS=800            # 单次生成上限（实测 500 会把终答截断）
AGENT_TOOL_RESULT_MAX_CHARS=4000   # 单个工具结果进 prompt 的字符上限
AGENT_TRACE_MAX_CHARS=20000        # 轨迹落库上限，超出则只保留摘要
AGENT_MAX_QUESTION_CHARS=2000      # 单条提问字数上限
AGENT_RAG_TOP_K=4                  # agent 内检索条数（比 RAG_TOP_K 小，结果还要叠加进上下文）
AGENT_RAG_MIN_SCORE=0.25           # 指南检索相关度下限；低于它视为"知识库没有这条"
AGENT_CONTEXT_TOKEN_BUDGET=3000    # 上下文 token 预算，超出触发分层压缩
AGENT_KEEP_RECENT_MESSAGES=6       # 压缩后至少保留的最近原文条数
AGENT_SUMMARY_ENABLED=true         # 会话摘要（存 Redis，跨进程）；每次摘要=一次额外 LLM 调用
AGENT_SUMMARY_MIN_MESSAGES=20      # 历史条数达到该值才考虑摘要
AGENT_SUMMARY_TTL=604800
# 工具能力覆盖。留空=用 provider 自带标志（openai/modelscope 支持 function calling，
# local 不支持，custom 默认不支持）。自建 OpenAI 兼容网关且确知支持时置 true。
# AGENT_PROVIDER_SUPPORTS_TOOLS=true

# ---------- 消息队列（阶段 8）----------
# 与缓存共用同一个 Redis，但分在不同的 db：db0 缓存、db1 broker、db2 结果后端。
# 改这两个值必须同步改 tasks/celery_app.py 里的默认值，否则两端对不上。
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

# ---------- 模型下载（网络受限时）----------
# huggingface.co 在国内常不可达；离线/内网环境可指定镜像与缓存目录
# HF_ENDPOINT=https://hf-mirror.com
# HF_HOME=D:/hf-cache
