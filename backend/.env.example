# 复制本文件为 .env 并按需修改
# .env 不会被提交到 git（见 .gitignore）

# ---------- 运行环境 ----------
# development | production
FLASK_ENV=development

# 日志级别：DEBUG | INFO（默认） | WARNING | ERROR
# 注意：DEBUG 会输出验证码明文，仅用于本地调试
LOG_LEVEL=INFO

# ---------- 安全（生产环境必须修改）----------
SECRET_KEY=dev-secret-key-change-in-production
JWT_SECRET_KEY=dev-jwt-secret-change-in-production

# ---------- 数据库 ----------
# 留空 / 注释掉 = 使用 SQLite：backend/instance/bone_detection.db
# 切换到 PostgreSQL 时取消注释（阶段 5）：
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/ortho

# ---------- 跨域 ----------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- 外部服务 ----------
AI_SERVICE_URL=http://127.0.0.1:8000

# ---------- 限流（次/分钟）----------
RATE_LIMIT_AI=10
RATE_LIMIT_GENERAL=100
